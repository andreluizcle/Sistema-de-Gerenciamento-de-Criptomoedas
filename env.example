# =============================================================================
# FT-Coin - configuracao do banco de dados (modelo)
# =============================================================================
# Copie este arquivo para .env na raiz do projeto e preencha com os valores
# reais. O .env esta no .gitignore e NAO deve ser versionado.
#
# As chaves sao lidas em tempo de execucao por br.unicamp.ftcoin.util.EnvLoader
# e usadas por br.unicamp.ftcoin.dao.DatabaseConnection. Tambem podem ser
# definidas como variaveis de ambiente do sistema, que tem prioridade sobre o
# arquivo.
#
# O servidor so responde dentro da intranet da faculdade.
# =============================================================================

# Endereco do servidor MariaDB
DB_HOST=143.106.243.64

# Porta TCP (padrao 3306)
DB_PORT=3306

# Nome do banco (schema)
DB_NAME=POO2_2s26_B03

# Usuario com permissao de leitura e escrita
DB_USER=POO2_2s26_B03

# Senha - NUNCA commitar o valor real
DB_PASSWORD=sua_senha_aqui
